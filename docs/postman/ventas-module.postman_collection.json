          { "key": "X-Session-Token", "value": "{{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"insertar_producto_venta\",\n  \"documento\": {{documentoId}},\n  \"producto_enviado\": \"{{productoId}}\",\n  \"cantidadVenta\": {{cantidadVenta}},\n  \"validarExistencia\": true,\n  \"precioVenta\": {\n    \"precio_con_iva\": {{precioConIva}},\n    \"precio_antes_de_iva\": {{precioAntesIva}},\n    \"valor_iva\": {{valorIva}}\n  },\n  \"key_registro\": \"{{token}}\",\n  \"_llaveSession\": \"{{token}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ventas/",
          "host": ["{{baseUrl}}"],
          "path": ["ventas", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Insertar producto responde 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Insercion sin error', function () { pm.expect(json.error).to.eql('ok'); });",
              "pm.test('Devuelve ordenDocumento', function () { pm.expect(json?.data?.ordenDocumento).to.exist; });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "07. Asignar pagos a documento",
